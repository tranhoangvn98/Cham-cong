# ====== Mau bi mat — copy thanh .env roi dien gia tri that. KHONG commit .env ======

# --- May chu (backend) ---
PORT=8080
NODE_ENV=development

# Chuoi ket noi PostgreSQL
DATABASE_URL=postgres://chamcong:doi_mat_khau@localhost:5432/chamcong

# Khoa ky JWT — BAT BUOC doi truoc khi len production.
# Sinh khoa moi: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_dai_48_byte
JWT_ACCESS_TTL=900          # giay — token truy cap (15 phut)
JWT_REFRESH_TTL=2592000     # giay — token lam moi (30 ngay)

# Mui gio may cham cong (may ZKTeco gui GIO DIA PHUONG, khong co offset)
DEVICE_TZ_OFFSET_HOURS=7

# Thu muc luu anh selfie khi cham cong bang dien thoai
THU_MUC_ANH=./du_lieu/anh_cham_cong

# Ban kinh geofence mac dinh (met) khi dia diem khong khai rieng
GEOFENCE_BAN_KINH_M=200

# Coi may la OFFLINE neu khong thay tin hieu qua so giay nay
MAY_OFFLINE_SAU_GIAY=180

# Nguon web duoc phep goi API (CORS), phan tach bang dau phay
CORS_ORIGIN=http://localhost:5173

# --- Dong bo sang ERP (tuy chon) ---
# De trong = tat. Neu dien, outbox se POST tung su kien len URL nay.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# --- Tai khoan admin khoi tao (chi dung cho lenh seed) ---
ADMIN_TEN_DANG_NHAP=admin
ADMIN_MAT_KHAU=doi_mat_khau_nay_ngay

# --- Webapp (build-time, file web/.env) ---
# VITE_API_URL=http://localhost:8080
