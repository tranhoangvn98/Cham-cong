# ====== Mau bi mat — copy thanh .env roi dien gia tri that. KHONG commit .env ======
#
#   cp .env.example .env
#   nano .env            # dien 4 gia tri o muc BAT BUOC ben duoi
#   docker compose up -d
#
# Sinh chuoi ngau nhien cho mat khau / khoa:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ==================================================================== BAT BUOC
# Bon gia tri nay khong co mac dinh — thieu la `docker compose up` dung ngay.

# Mat khau PostgreSQL trong container. Dat gi cung duoc mien la manh; khong ai
# phai nho vi cong 5432 khong mo ra ngoai.
POSTGRES_PASSWORD=

# Khoa ky JWT. Doi khoa nay = dang xuat toan bo nguoi dung.
JWT_SECRET=

# Mat khau tai khoan admin dau tien (dung cho lenh seed).
ADMIN_MAT_KHAU=

# Dia chi API ma TRINH DUYET va DIEN THOAI goi tới.
#
# CAN THAN: gia tri nay duoc nhung vao ma JavaScript luc BUILD, khong doc luc chay.
# Doi no phai build lai webapp: docker compose up -d --build web
#
#   Chi thu tren chinh may chay Docker   -> http://localhost:8080
#   May khac / dien thoai trong LAN      -> http://192.168.1.10:8080   (IP thuc cua may chu)
#   Da co ten mien + HTTPS               -> https://chamcong.congty.vn
VITE_API_URL=http://localhost:8080

# Nguon web duoc phep goi API (CORS). Phai khop origin ma nguoi dung mo webapp,
# KHAC voi VITE_API_URL (do la dia chi API). Nhieu gia tri thi phan tach bang dau phay.
#
#   Chay bang Docker      -> http://localhost:8081
#   Trong LAN             -> http://192.168.1.10:8081
#   Vua Docker vua dev    -> http://localhost:8081,http://localhost:5173
CORS_ORIGIN=http://localhost:8081

# IP duoc phep goi /iclock/* (cong may cham cong), phan tach bang dau phay.
# Ho tro CIDR: 203.0.113.45,192.168.1.0/24
#
#   May chu trong LAN kin        -> de TRONG (cho phep tat ca)
#   May chu co dia chi cong khai -> BAT BUOC dien IP cong khai cua van phong
#
# Vi sao khong chan bang tuong lua: cong 8080 con phuc vu /api/* cho dien thoai va may
# nhan su o moi noi, ma tuong lua khong phan biet duong dan. De trong tren may chu cong
# khai = ai biet serial may cung day duoc lan quet gia vao bang cong.
#
# Lay IP cong khai cua van phong: chay `curl -s https://api.ipify.org` tu mot may TRONG
# van phong. Van phong dung IP dong thi xem tai_lieu/TRIEN-KHAI.md.
ICLOCK_IP_CHO_PHEP=

# ==================================================================== NGHIEP VU

# Mui gio NOI DAT MAY CHAM CONG. May ZKTeco gui gio dia phuong khong kem offset,
# nen dat sai la lech toan bo gio cong. Viet Nam = 7.
DEVICE_TZ_OFFSET_HOURS=7

# Coi may la OFFLINE neu khong thay tin hieu qua so giay nay. May ZKTeco thuong
# bao hieu moi 30-60 giay, nen 180 la du de khong bao dong gia.
MAY_OFFLINE_SAU_GIAY=180

# Ban kinh geofence mac dinh (met) khi dia diem khong khai rieng.
# GPS trong nha lech 10-50m — dat duoi 100 se luon bao "ngoai pham vi".
GEOFENCE_BAN_KINH_M=200

# ==================================================================== TUY CHON

JWT_ACCESS_TTL=900          # giay — token truy cap (15 phut)
JWT_REFRESH_TTL=2592000     # giay — token lam moi (30 ngay)

ADMIN_TEN_DANG_NHAP=admin

# Dong bo sang ERP. De trong = tat. Neu dien, outbox POST tung su kien len URL nay
# (gom ca canh bao thiet_bi.mat_ket_noi).
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# ==================================================================== CHAY KHONG QUA DOCKER
# Ba bien duoi CHI dung khi chay `npm run may_chu` truc tiep tren may.
# Docker compose tu dat gia tri rieng, khong doc phan nay.

DATABASE_URL=postgres://chamcong:chamcong_dev@localhost:5432/chamcong
PORT=8080
NODE_ENV=development
THU_MUC_ANH=./du_lieu/anh_cham_cong
