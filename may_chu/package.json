{
  "name": "@cham-cong/may-chu",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Backend: cong ADMS cho may ZKTeco + REST API cho webapp va app dien thoai",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "di_tru": "node --experimental-strip-types src/csdl/chay_di_tru.ts",
    "seed": "node --experimental-strip-types src/csdl/seed.ts",
    "test": "node --experimental-strip-types --test test/giao_thuc.test.ts test/tinh_cong.test.ts test/bao_mat.test.ts test/dia_chi_ip.test.ts test/microsoft.test.ts && node --experimental-strip-types --test test/proxy_tin_cay.test.ts",
    "kiem_tra_kieu": "tsc -p tsconfig.kiem_tra.json",
    "test_e2e": "node --experimental-strip-types --test test/e2e.test.ts",
    "test_tat_ca": "npm test && npm run test_e2e"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2"
  }
}
